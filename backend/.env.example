# 本地复制为 backend/.env。Vercel 在 Flask 项目逐项配置。
# 示例对应文档里的本地 PostgreSQL。生产填写数据库平台提供的连接串。
DATABASE_URL=postgresql://itip:itip-local-password@127.0.0.1:5432/itip
# 使用至少 32 字节随机值。若迁移现有站点，可沿用原 JWT 密钥。
AUTH_SECRET=
# 必须与前端项目一致；仅纯本地开发可留空。
BACKEND_PROXY_SECRET=
# 本地默认关闭。Vercel 自动启用 Secure Cookie。
COOKIE_SECURE=0

# OpenAI 兼容端点和实际可调用的模型 ID。以下为智谱配置示例。
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=
AI_MODEL=glm-4-flash
AI_VISION_MODEL=glm-4v-flash
AI_IMAGE_MODEL=cogview-3-flash
