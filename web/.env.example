# 复制为 .env.local 后修改。切勿把真实密钥提交到 Git。
# 随机字符串，用于 JWT 签名，至少 16 字符
AUTH_SECRET=change-me-to-a-long-random-string

# 站点 URL，用于 SEO 元数据（sitemap、Open Graph 等）。生产环境设为真实域名。
# SITE_URL=https://itip.example.com

# SQLite 路径；默认 {项目根}/data/itip.db
# DATABASE_PATH=./data/itip.db

# ========= 模型：OpenAI【兼容】协议 =========
# 变量名以 AI_* 为准（优先于旧名 OPENAI_*）。
# —— 推荐：智谱 GLM 直连（无需 Ollama）——
# 在 https://open.bigmodel.cn 创建 API Key；OpenAI 兼容说明见官方文档。
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=你的智谱_API_Key
# 对话模型名以控制台为准，例如 glm-4-flash、glm-4-plus、glm-4-air 等
AI_MODEL=glm-4-flash

# 视觉模型（上传图片时自动切换）。智谱默认 glm-4v-flash
# AI_VISION_MODEL=glm-4v-flash

# 图片生成模型（须支持 OpenAI 兼容 /v1/images/generations 端点）
# 智谱默认 cogview-3-flash（快速）；可选 cogview-3-plus（高质量）
# AI_IMAGE_MODEL=cogview-3-flash

# —— 可选：本机 Ollama（需自行 pull 模型并启动服务）——
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.2
# AI_API_KEY 可留空

# 兼容旧名：AI_* 优先；
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
