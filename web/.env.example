# 复制为 .env.local 后修改。切勿把真实密钥提交到 Git。

# 随机字符串，用于 JWT 签名，至少 16 字符
AUTH_SECRET=change-me-to-a-long-random-string

# SQLite 路径；默认 {项目根}/data/itip.db
# DATABASE_PATH=./data/itip.db

# ========= 模型：OpenAI【兼容】协议，不绑定美国 OpenAI =========
# 推荐变量名（优先于下方 OPENAI_* 旧名）：

# 例 1 本机 Ollama（先 ollama pull 模型，并 ollama serve）
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.2
# AI_API_KEY 可留空（将使用内部占位，由 Ollama 忽略）

# 例 1b 本机 Ollama + 智谱 GLM 系列（Ollama 库中的开放权重，如 glm4 / glm-4.6 等，以 ollama.com/library 为准）
# ollama pull glm4
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=glm4
# AI_API_KEY 可留空

# 例 1c 智谱云端 GLM（OpenAI 兼容，需 API Key；非本地权重，但同属 GLM）
# 文档：https://open.bigmodel.cn/dev/api （OpenAI 兼容说明）
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_API_KEY=你的智谱开放平台 Key
# AI_MODEL=glm-4-flash 或 glm-4-plus 等（以控制台模型名为准）

# 例 2 任意云/区：按服务商文档填 Base 与 Key（如 OpenRouter、Groq、部分国内云「OpenAI 兼容」）
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.1-8b-instant

# 例 3 仍用 OpenAI 官方（旧名依然支持）
# OPENAI_API_KEY=
# OPENAI_BASE_URL 通常可省略

# 兼容旧名（与 AI_* 二选一；AI_* 优先）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o
