# 复制为 frontend/.env.local。Vercel 在前端项目配置这些变量。
# 本地缺省使用 Flask 的 5000 端口，生产环境填 Flask 项目的 HTTPS 地址。
FLASK_API_URL=http://127.0.0.1:5000
# 必须与 Flask 项目的同名变量一致，生产环境使用随机值。
BACKEND_PROXY_SECRET=
# 后端域名启用 Vercel Deployment Protection 时，填写后端项目的自动化绕过密钥。
VERCEL_BACKEND_BYPASS_SECRET=
# 生产环境填写用户实际访问的前端域名。
SITE_URL=http://localhost:3000
