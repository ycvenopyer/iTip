# 复制为 .env.local 后修改。切勿把真实密钥提交到 Git。

# 随机字符串，用于 JWT 签名，至少 16 字符
AUTH_SECRET=change-me-to-a-long-random-string

# SQLite 路径；默认 {项目根}/data/itip.db
# DATABASE_PATH=./data/itip.db

# OpenAI 兼容 API：官方 OpenAI 或 vLLM、Ollama 网关等
OPENAI_API_KEY=
# 可选项；默认走官方 API 根路径
# OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名（需支持多模态如 gpt-4o 时才能用图片附件）
OPENAI_MODEL=gpt-4o
